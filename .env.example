PI_PROVIDER=openai
PI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-api-key-here
PI_MAX_CONCURRENT_CONTAINERS=4
PI_IDLE_TIMEOUT_MINUTES=10
MAX_HISTORY_MESSAGES=40
HOST_WORKSPACE_ROOT=/absolute/path/to/your/project
HOST_DATA_ROOT=/absolute/path/to/agentcraft-data
AGENTCRAFT_WORKSPACE_ROOT=/workspaces/authorized
AGENTCRAFT_DATA_ROOT=/data
TASK_FILE_ROOT=/data/task-files
PI_WORKER_IMAGE=agentcraft-pi-worker:0.84.3
DOCKER_API_URL=http://docker-socket-proxy:2375
PI_PROXY_BASE_URL=http://provider-proxy:8080/v1
PROVIDER_PROXY_UPSTREAM=https://api.openai.com
MCP_ENCRYPTION_ACTIVE_KID=primary
MCP_ENCRYPTION_KEYRING=primary:base64url-encoded-32-byte-key
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_FILES_PER_REQUEST=10
UPLOAD_MAX_TASK_BYTES=104857600
# 强随机值（≥32字符），占位符无法通过启动校验，必须编辑后再启动
SECRET_KEY=<必须替换：至少32字符强随机值>
# 任务凭据签名密钥，必须与 SECRET_KEY 不同
TASK_TOKEN_SECRET=<必须替换：另一个32字符强随机值>
# 仅开发/测试逃生舱，生产禁止置 true
ALLOW_INSECURE_SECRETS=false
DATABASE_URL=sqlite+aiosqlite:////data/agentcraft.db

# ---- V2 认证/会话（Phase 2）----
# V2 业务面 DSN（agentcraft_app role）；与 V2_ADMIN_DATABASE_URL 同时非空才进入 V2 模式，否则为 V1-only
V2_DATABASE_URL=
# V2 认证面/系统作业 DSN（agentcraft_admin role）；必须与 V2_DATABASE_URL 同时配置
V2_ADMIN_DATABASE_URL=
# 四把 V2 密钥材料（b64url 32 字节），进入 V2 模式后必须全部设置、互不相同、且与 SECRET_KEY/TASK_TOKEN_SECRET 不同
# 生成方式：python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
MFA_ENCRYPTION_KEY=
EMAIL_OUTBOX_ENCRYPTION_KEY=
RATE_LIMIT_HMAC_KEY=
# b64url 32B；user_providers BYOK DEK 包装 KEK（生成：python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"）
PROVIDER_KEY_ENCRYPTION_KEY=
# outbox 邮件传输选择：console（dev，打日志）| mailegress（生产占位，部署阶段接线）
MAIL_TRANSPORT=console
# dev 经 http://localhost 时浏览器豁免；LAN 调试可关（需 ALLOW_INSECURE_SECRETS=true，否则启动校验失败）
SESSION_COOKIE_SECURE=true
