# MCP stdio 沙箱镜像（§10.2：业务 MCP Server 运行于独立受限沙箱容器）
# McpClient 每次调用经 `docker run --rm -i agentcraft-mcp-sandbox sh -c <command>`
# 拉起一次性容器；env 以 -e 注入（可能含密钥，禁止日志输出）。
# 受限网络环境可用 --build-arg NPM_REGISTRY=https://registry.npmmirror.com
FROM node:22-slim

ARG NPM_REGISTRY=https://registry.npmjs.org

RUN npm config set registry ${NPM_REGISTRY} && \
    npm install -g @modelcontextprotocol/server-filesystem && \
    useradd --create-home --shell /bin/bash mcpworker && \
    mkdir -p /workspace && chown mcpworker:mcpworker /workspace

# 非 root 运行；无网络出站由运行时 --network agentcraft-internal（internal）施加
USER mcpworker
WORKDIR /workspace

# 命令由 McpClient 以 sh -c <command> 追加，无固定入口
CMD ["sleep", "infinity"]
